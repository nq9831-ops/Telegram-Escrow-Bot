<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <!-- 刻意停在 3.5.16，不要升 4.x：
         Boot 4.x 使用 Jackson 3（tools.jackson），而 TelegramBots 10.3.0 使用
         Jackson 2 注解（com.fasterxml.jackson.annotation），二者不兼容。
         症状是【静默失效】——Update 反序列化失败（no Creators），请求被异常处理器
         吞成 200 空响应、handler 永不执行。排查成本极高，故版本锁死并记录在此。 -->
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.tg.escrow</groupId>
  <artifactId>telegram-escrow-bot</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>telegram-escrow-bot</name>
  <description>Telegram 群管理 + 担保交易工具包（开源 / AGPL-3.0）</description>

  <licenses>
    <license>
      <name>GNU Affero General Public License v3.0</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <!-- 模块划分（链上部分单列 tgg-chain；按当前范围不引入挂单/后台模块）：
       tgg-common       公共契约（异常基类等），不依赖任何内部模块
       tgg-core         群管理（用户/内容/自动化/配置/反滥用）
       tgg-federation   联邦仲裁与节点签名（escrow 的裁决签名依赖它）
       tgg-escrow       担保交易（订单状态机 / 裁决规则 / 账本）
       tgg-chain        链上部分：TON 合约与链上事件接入（新增，待实现）
       tgg-app          应用装配与启动 -->
  <modules>
    <module>tgg-common</module>
    <module>tgg-core</module>
    <module>tgg-federation</module>
    <module>tgg-escrow</module>
    <module>tgg-chain</module>
    <module>tgg-app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.tg.escrow</groupId>
        <artifactId>tgg-common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.escrow</groupId>
        <artifactId>tgg-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.escrow</groupId>
        <artifactId>tgg-federation</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.escrow</groupId>
        <artifactId>tgg-escrow</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tg.escrow</groupId>
        <artifactId>tgg-chain</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <plugins>
      <!-- 默认 surefire 只跑 *Test；集成测试（*IT）须由 failsafe 在 verify 阶段执行。
           没有它，任何 *IT 会被【静默跳过】——BUILD SUCCESS 并不代表端到端跑过。 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
